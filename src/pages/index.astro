---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts).filter(({ data }) => !data.archived);
const recentPosts = sortedPosts;
const featuredProjects = (
  await getCollection("projects", ({ data }) => data.published && data.featured)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredPapers = (
  await getCollection(
    "publications",
    ({ data }) => data.published && data.featured
  )
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-stretch sm:gap-5">
        <!-- Replace public/brand/headshot.jpeg with your preferred portrait. -->
        <div class="relative aspect-square w-1/4 shrink-0 sm:self-end">
          <img
            src={getAssetPath("brand/headshot.jpeg")}
            alt="Samantha Mallari"
            width="192"
            height="192"
            class="border-border absolute inset-0 h-full w-full border object-cover"
          />
        </div>
        <div class="flex min-w-0 flex-1 flex-col">
          <div class="mb-4 flex items-center gap-3">
            <h1 class="text-3xl font-bold">
              Aloha, I’m Samantha! . ݁₊ ⊹ . ݁˖ . ݁
            </h1>
          </div>

          <p>
            I’m a software engineer based in Honolulu, working across embedded
            systems, space, and machine learning. Welcome to my corner of the
            internet.
          </p>
          <p class="mt-2">
            A collection of notes, ideas, and things I’m building.
          </p>
          {
            socials.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-y-2 max-sm:flex-col sm:mt-auto sm:items-center sm:pt-4">
                <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                  {t.home.socialLinks}:
                </div>
                <Socials />
                <p class="text-accent italic sm:ms-4">
                  ad astra per aspera ✧˖°.
                </p>
              </div>
            )
          }
        </div>
      </div>
    </section>

    {
      featuredProjects.length > 0 && (
        <section
          id="featured-projects"
          class:list={["pt-12 pb-6", { "border-border border-b": true }]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            Featured Projects
          </h2>
          <ul class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
            {featuredProjects.map(project => (
              <ProjectCard project={project} />
            ))}
          </ul>
          <div class="mt-6 text-center">
            <LinkButton href={getRelativeLocaleUrl(locale, "projects")}>
              All Projects <IconArrowRight />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      featuredPapers.length > 0 && (
        <section id="featured-papers" class="border-border border-b pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            Featured Publications
          </h2>
          <ul>
            {featuredPapers.map(({ id, data }) => (
              <li class="my-6">
                <a
                  href={data.link || `/publications/${id}/`}
                  class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
                >
                  <h3>{data.title}</h3>
                </a>
                <p class="text-muted-foreground my-1 text-sm">
                  <time datetime={data.date.toISOString()}>
                    {data.date.toLocaleDateString("en", {
                      month: "short",
                      year: "numeric",
                      timeZone: "UTC",
                    })}
                  </time>
                </p>
                <p>{data.authors}</p>
                <p class="text-muted-foreground mt-1 text-sm">{data.venue}</p>
              </li>
            ))}
          </ul>
          <div class="mt-6 text-center">
            <LinkButton href={getRelativeLocaleUrl(locale, "publications")}>
              All Publications <IconArrowRight />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      true && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          {recentPosts.length === 0 && (
            <p class="mt-4">New posts coming soon.</p>
          )}
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
